<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0D1D31" />
            <stroke android:width="2dp" android:color="@color/blue_500" />
            <corners android:radius="12dp" />
            <padding android:left="14dp" android:top="12dp" android:right="14dp" android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D1D31" />
            <stroke android:width="1dp" android:color="#35516E" />
            <corners android:radius="12dp" />
            <padding android:left="14dp" android:top="12dp" android:right="14dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
